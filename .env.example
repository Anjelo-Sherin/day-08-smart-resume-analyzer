# Optional: Google Gemini API Key for live Gemini 3.8 Flash bullet-point rewrites
# Get a free key at https://aistudio.google.com/apikey
# Note: The app works 100% offline without a key using the built-in Guardrailed XYZ/STAR Coach Engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Backend & Frontend Ports
PORT=8008
NEXT_PUBLIC_API_URL=http://localhost:8008
DATABASE_URL=sqlite:///./data/rolefit.db
